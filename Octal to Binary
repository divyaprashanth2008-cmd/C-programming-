#include <stdio.h>
#include <math.h>

int main() {
    int octal, decimal = 0, binary[32], i = 0;
    int base = 1, remainder;

    printf("Enter an octal number: ");
    scanf("%d", &octal);

    while (octal > 0) {
        remainder = octal % 10;
        decimal = decimal + remainder * base;
        octal = octal / 10;
        base = base * 8;
    }

    while (decimal > 0) {
        binary[i] = decimal % 2;
        decimal = decimal / 2;
        i++;
    }

    printf("Binary = ");
    for (int j = i - 1; j >= 0; j--) {
        printf("%d", binary[j]);
    }

    return 0;
}