#include <stdio.h>

int main() {
    char str[100];
    int i=0, len=0;
    char temp;

    scanf("%s", str);

    while(str[len]) len++;   // find length

    for(i=0; i<len/2; i++) {
        temp = str[i];
        str[i] = str[len-1-i];
        str[len-1-i] = temp;
    }

    printf("%s", str);

    return 0;
}