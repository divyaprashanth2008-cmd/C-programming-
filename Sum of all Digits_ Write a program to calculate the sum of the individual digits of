#include <stdio.h>

int main() {
    int num, sum = 0, temp;

    printf("Enter an integer: ");
    scanf("%d", &num);

    temp = num;

    while (temp > 0) {
        sum += temp % 10;   // extract last digit and add
        temp /= 10;         // remove last digit
    }

    printf("Sum of digits of %d = %d\n", num, sum);

    return 0;
}
