#include <stdio.h>
#include <string.h>

int main() {
    char str[200];
    printf("Enter a string: ");
    scanf("%s", str);

    int n = strlen(str);
    printf("Compressed string (Run-Length Encoding): ");

    for (int i = 0; i < n; i++) {
        int count = 1;
        // Count consecutive occurrences
        while (i < n - 1 && str[i] == str[i + 1]) {
            count++;
            i++;
        }
        printf("%c%d", str[i], count);
    }

    printf("\n");
    return 0;
}
