#include <stdio.h>

int main() {
    int n, d, arr[100];

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter %d elements: ", n);
    for (int i = 0; i < n; i++) scanf("%d", &arr[i]);

    printf("Enter rotation value (d): ");
    scanf("%d", &d);

    d = d % n;  // handle cases where d > n

    int temp[100];
    int k = 0;

    // Copy elements from d to end
    for (int i = d; i < n; i++) temp[k++] = arr[i];

    // Copy first d elements
    for (int i = 0; i < d; i++) temp[k++] = arr[i];

    printf("Array after left rotation by %d: ", d);
    for (int i = 0; i < n; i++) printf("%d ", temp[i]);
    printf("\n");

    return 0;
}
